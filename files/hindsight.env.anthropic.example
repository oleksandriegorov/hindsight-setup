# Copy to ~/.hindsight/hindsight.env (chmod 600). Paste a Console API key (sk-ant-api03-...) after the = sign.
# A subscription token (sk-ant-oat01-...) does not work.
HINDSIGHT_API_LLM_PROVIDER=anthropic
HINDSIGHT_API_LLM_MODEL=claude-haiku-4-5
HINDSIGHT_API_LLM_API_KEY=
# Haiku 4.5 has a 64k output limit
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=60000
