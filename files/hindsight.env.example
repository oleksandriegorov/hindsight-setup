# Copy to ~/.hindsight/hindsight.env (chmod 600). The compose file "environment:" block overrides these values.
HINDSIGHT_API_LLM_PROVIDER=openai-codex
HINDSIGHT_API_LLM_MODEL=gpt-5.6-luna
HINDSIGHT_API_WORKER_ID=macbook-local
HINDSIGHT_API_LLM_CODEX_HOME=/home/hindsight/.codex
# Rollback to Anthropic (API key from console.anthropic.com, not a subscription token):
#HINDSIGHT_API_LLM_PROVIDER=anthropic
#HINDSIGHT_API_LLM_MODEL=claude-haiku-4-5
#HINDSIGHT_API_LLM_API_KEY=sk-ant-api03-...
